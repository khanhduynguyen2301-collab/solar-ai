# Copy to ignored .env and supply a private local password before starting.
# Use plain unquoted KEY=value entries (no interpolation or inline comments).
POSTGRES_DB=solar_farm_ai
POSTGRES_USER=solar_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: LLM explanations in the agent log. Leave empty to use templated text only.
ANTHROPIC_API_KEY=

# Other optional settings and their defaults are listed in docs/operations.md.
